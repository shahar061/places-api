# Places API Environment Configuration

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080

# Database Configuration (Required)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here  # Use service_role key (not anon key!) for backend

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=places-cluster

# AI Configuration (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=deepseek/deepseek-chat-v3.1:free

# Geocoding Configuration (Optional)
# LocationIQ provides fallback geocoding when Photon fails
# Free tier: 5,000 requests/day (~150,000/month)
# Sign up at: https://locationiq.com/
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal, panic, disabled
LOG_LEVEL=info

# Log formats: json (for production), console (for development)
LOG_FORMAT=json

# Time formats: unix, rfc3339, or custom format
LOG_TIME_FORMAT=rfc3339

# Application Version (for logging context)
APP_VERSION=1.0.0
