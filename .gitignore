# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Debug binaries
__debug_bin*

# Build directories
/bin/
/build/
/dist/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log
logs/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Air (live reload) temporary files
tmp/

# Coverage reports
coverage.txt
coverage.out
coverage.html

# Temporary files
*.tmp
*.temp

# Config files with sensitive data (if any)
# config/local.yaml
# configs/local.yaml

# Documentation generation artifacts (if using tools like swagger-codegen)
# docs/generated/
